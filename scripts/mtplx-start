#!/usr/bin/env zsh
# Foreground MTPLX OpenAI-compatible server for local pi/Prime use.
# Uses native MTP by default and serves model id "mtplx" on 127.0.0.1:8000.

set -euo pipefail

MODEL="${MTPLX_MODEL:-Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed}"
MODEL_ID="${MTPLX_MODEL_ID:-mtplx}"
HOST="${MTPLX_HOST:-127.0.0.1}"
PORT="${MTPLX_PORT:-8000}"
PASSTHRU=("$@")

if [[ -f "$HOME/.config/nativ/cacert.pem" ]]; then
  export SSL_CERT_FILE="$HOME/.config/nativ/cacert.pem"
  export REQUESTS_CA_BUNDLE="$HOME/.config/nativ/cacert.pem"
  export CURL_CA_BUNDLE="$HOME/.config/nativ/cacert.pem"
  export NODE_EXTRA_CA_CERTS="$HOME/.config/nativ/cacert.pem"
  export GRPC_DEFAULT_SSL_ROOTS_FILE_PATH="$HOME/.config/nativ/cacert.pem"
  export AWS_CA_BUNDLE="$HOME/.config/nativ/cacert.pem"
fi
export HF_HUB_DISABLE_XET=1
export HF_HUB_ENABLE_HF_TRANSFER=0

exec mtplx serve \
  --model "$MODEL" \
  --model-id "$MODEL_ID" \
  --host "$HOST" \
  --port "$PORT" \
  --no-auth \
  --mtp \
  "${PASSTHRU[@]}"
